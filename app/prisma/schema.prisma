generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id           String  @id @default(uuid()) @db.Uuid
  firstName    String?
  lastName     String?
  fullName     String?
  email        String  @unique
  passwordHash String?
  avatarUrl    String?
  googleId     String? @unique
  role         UserRole @default(USER)
  isActive     Boolean @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  sessions      UserSession[]
  companies     UserCompany[]
  documents     Document[]       @relation("DocumentOwner")
  contracts     Contract[]       @relation("ContractCreator")
  templates     Template[]       @relation("TemplateCreator")
  approvals     Approval[]
  payments      Payment[]
  notifications Notification[]
  subscriptions Subscription[]
  auditLogs     AuditLog[]
  fileUploads   FileUpload[]
}

model UserSession {
  id           String   @id @default(uuid()) @db.Uuid
  userId       String   @db.Uuid
  refreshToken String   @unique
  ipAddress    String?
  userAgent    String?
  expiresAt    DateTime
  createdAt    DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Company {
  id                 String   @id @default(uuid()) @db.Uuid
  name               String
  registrationNumber String   @unique
  industry           String?
  address            String?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  users     UserCompany[]
  documents Document[]
  contracts Contract[]
}

model UserCompany {
  id             String           @id @default(uuid()) @db.Uuid
  userId         String           @db.Uuid
  companyId      String           @db.Uuid
  position       String?
  permissionRole PermissionRole   @default(MEMBER)
  joinedAt       DateTime         @default(now())

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@unique([userId, companyId])
  @@index([companyId])
}

model TemplateCategory {
  id          String   @id @default(uuid()) @db.Uuid
  name        String   @unique
  description String?  @db.Text
  createdAt   DateTime @default(now())

  templates Template[]
}

model Template {
  id          String   @id @default(uuid()) @db.Uuid
  name        String
  description String?  @db.Text
  category    String
  content     String   @db.Text
  variables   Json?
  isActive    Boolean  @default(true)
  createdById String   @db.Uuid
  categoryId  String?  @db.Uuid
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  createdBy        User              @relation("TemplateCreator", fields: [createdById], references: [id])
  templateCategory TemplateCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  documents        Document[]
  contracts        Contract[]

  @@index([createdById])
  @@index([categoryId])
}

model Document {
  id         String         @id @default(uuid()) @db.Uuid
  title      String
  content    String?        @db.Text
  rawInput   Json?
  fileUrl    String?
  fileType   String?
  status     DocumentStatus @default(DRAFT)
  ownerId    String         @db.Uuid
  companyId  String?        @db.Uuid
  templateId String?        @db.Uuid
  createdAt  DateTime       @default(now())
  updatedAt  DateTime       @updatedAt

  owner        User           @relation("DocumentOwner", fields: [ownerId], references: [id])
  company      Company?       @relation(fields: [companyId], references: [id], onDelete: SetNull)
  template     Template?      @relation(fields: [templateId], references: [id], onDelete: SetNull)
  contract     Contract?
  riskAnalysis RiskAnalysis?
  fileUploads  FileUpload[]

  @@index([ownerId])
  @@index([companyId])
  @@index([templateId])
}

model Contract {
  id           String         @id @default(uuid()) @db.Uuid
  title        String
  contractType String?
  parties      Json?
  value        Decimal?       @db.Decimal(14, 2)
  currency     String         @default("MNT")
  startDate    DateTime?      @db.Date
  endDate      DateTime?      @db.Date
  status       ContractStatus @default(DRAFT)
  documentId   String         @unique @db.Uuid
  templateId   String?        @db.Uuid
  createdById  String         @db.Uuid
  companyId    String?        @db.Uuid
  signedAt     DateTime?
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt

  document     Document        @relation(fields: [documentId], references: [id])
  template     Template?       @relation(fields: [templateId], references: [id], onDelete: SetNull)
  createdBy    User            @relation("ContractCreator", fields: [createdById], references: [id])
  company      Company?        @relation(fields: [companyId], references: [id], onDelete: SetNull)
  contractParties ContractParty[]
  clauses      Clause[]
  approvals    Approval[]
  payments     Payment[]
  riskAnalysis RiskAnalysis?

  @@index([templateId])
  @@index([createdById])
  @@index([companyId])
}

model ContractParty {
  id               String    @id @default(uuid()) @db.Uuid
  contractId       String    @db.Uuid
  name             String
  email            String?
  phone            String?
  role             PartyRole @default(OTHER)
  organizationName String?
  address          String?   @db.Text
  createdAt        DateTime  @default(now())

  contract Contract @relation(fields: [contractId], references: [id], onDelete: Cascade)

  @@index([contractId])
}

model Clause {
  id          String     @id @default(uuid()) @db.Uuid
  contractId  String     @db.Uuid
  title       String
  content     String     @db.Text
  clauseType  String?
  riskLevel   RiskLevel?
  explanation String?    @db.Text
  orderNo     Int        @default(0)
  createdAt   DateTime   @default(now())

  contract Contract       @relation(fields: [contractId], references: [id], onDelete: Cascade)
  tags     ClauseTagMap[]

  @@index([contractId])
}

model ClauseTag {
  id          String  @id @default(uuid()) @db.Uuid
  name        String  @unique
  description String? @db.Text

  clauses ClauseTagMap[]
}

model ClauseTagMap {
  id       String @id @default(uuid()) @db.Uuid
  clauseId String @db.Uuid
  tagId    String @db.Uuid

  clause Clause    @relation(fields: [clauseId], references: [id], onDelete: Cascade)
  tag    ClauseTag @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@unique([clauseId, tagId])
  @@index([tagId])
}

model RiskAnalysis {
  id                  String   @id @default(uuid()) @db.Uuid
  contractId          String?  @unique @db.Uuid
  documentId          String?  @unique @db.Uuid
  summary             String?  @db.Text
  riskScore           Int
  risks               Json?
  missingClauses      Json?
  riskyTerms          Json?
  inconsistentWording Json?
  complianceWarnings  Json?
  estimatedCost       Decimal? @db.Decimal(14, 2)
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  contract Contract? @relation(fields: [contractId], references: [id], onDelete: Cascade)
  document Document? @relation(fields: [documentId], references: [id], onDelete: Cascade)
}

model Approval {
  id         String         @id @default(uuid()) @db.Uuid
  contractId String         @db.Uuid
  userId     String         @db.Uuid
  status     ApprovalStatus @default(PENDING)
  comment    String?        @db.Text
  approvedAt DateTime?
  orderNo    Int            @default(0)
  createdAt  DateTime       @default(now())

  contract Contract @relation(fields: [contractId], references: [id], onDelete: Cascade)
  user     User     @relation(fields: [userId], references: [id])

  @@unique([contractId, userId, orderNo])
  @@index([userId])
}

model Payment {
  id            String        @id @default(uuid()) @db.Uuid
  contractId    String        @db.Uuid
  userId        String        @db.Uuid
  amount        Decimal       @db.Decimal(14, 2)
  currency      String        @default("MNT")
  status        PaymentStatus @default(PENDING)
  paymentMethod String?
  paidAt        DateTime?
  invoiceUrl    String?
  createdAt     DateTime      @default(now())

  contract Contract @relation(fields: [contractId], references: [id], onDelete: Cascade)
  user     User     @relation(fields: [userId], references: [id])

  @@index([contractId])
  @@index([userId])
}

model Notification {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @db.Uuid
  type      String
  title     String
  message   String   @db.Text
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, isRead])
}

model Subscription {
  id        String             @id @default(uuid()) @db.Uuid
  userId    String             @db.Uuid
  plan      String
  status    SubscriptionStatus @default(ACTIVE)
  startDate DateTime           @db.Date
  endDate   DateTime?          @db.Date
  createdAt DateTime           @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model AuditLog {
  id          String   @id @default(uuid()) @db.Uuid
  userId      String?  @db.Uuid
  action      String
  entityType  String
  entityId    String?  @db.Uuid
  description String?  @db.Text
  ipAddress   String?
  createdAt   DateTime @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([entityType, entityId])
}

model FileUpload {
  id         String   @id @default(uuid()) @db.Uuid
  userId     String   @db.Uuid
  documentId String?  @db.Uuid
  fileName   String
  fileUrl    String
  mimeType   String?
  size       BigInt?
  uploadedAt DateTime @default(now())

  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  document Document? @relation(fields: [documentId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([documentId])
}

enum UserRole {
  USER
  ADMIN
}

enum PermissionRole {
  OWNER
  ADMIN
  MEMBER
  VIEWER
}

enum DocumentStatus {
  DRAFT
  FINAL
  ARCHIVED
}

enum ContractStatus {
  DRAFT
  REVIEW
  APPROVED
  SIGNED
  ARCHIVED
}

enum PartyRole {
  PARTY
  SIGNER
  OTHER
}

enum RiskLevel {
  LOW
  MEDIUM
  HIGH
}

enum ApprovalStatus {
  PENDING
  APPROVED
  REJECTED
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
  REFUNDED
}

enum SubscriptionStatus {
  ACTIVE
  CANCELLED
  EXPIRED
}
