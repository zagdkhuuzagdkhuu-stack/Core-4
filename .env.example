PORT=3000

# Frontend
VITE_API_BASE_URL=http://localhost:3000
VITE_GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com

# Database
DATABASE_URL="postgresql://user:password@localhost:5432/db_name?schema=public"
DB_HOST=localhost
DB_PORT=5432
DB_USER=your_db_user
DB_PASSWORD=your_db_password
DB_NAME=your_db_name

# JWT / Encryption
JWT_SECRET=your_jwt_secret
SECRETKEY=your_32_char_secret_key

# Google OAuth
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret

# Google Gemini AI — https://aistudio.google.com/apikey
GEMINI_API_KEY=your_gemini_api_key
# Model for contract analysis (default: gemini-2.5-flash). Avoid gemini-2.0-flash if you see quota limit: 0.
GEMINI_MODEL=gemini-2.5-flash

# QPay merchant API
QPAY_BASE_URL=https://merchant-sandbox.qpay.mn/v2
QPAY_MERCHANT_USERNAME=your_qpay_client_id
QPAY_MERCHANT_PASSWORD=your_qpay_client_secret
QPAY_INVOICE_CODE=TEST_INVOICE
QPAY_CALLBACK_URL=http://localhost:3000/api/payments/qpay/callback
